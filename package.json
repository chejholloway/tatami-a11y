{
  "name": "tatami-a11y",
  "version": "0.1.0",
  "description": "Framework-agnostic, accessibility-first UI primitives for vanilla JavaScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "node scripts/test-verbose.js",
    "typecheck": "tsc --noEmit",
    "serve": "http-server . -p 8080 -o /demo/index.html"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "vanilla-js",
    "headless",
    "ui-primitives",
    "focus-trap",
    "live-region",
    "focus-stack",
    "screen-reader",
    "reduced-motion"
  ],
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
