{
  "name": "tatami-a11y",
  "version": "1.0.0",
  "description": "Framework-agnostic, accessibility-first UI primitives for vanilla JavaScript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "shared_a11y_primitives_problem.png"
  ],
  "scripts": {
    "build:surge": "node scripts/build-surge.js",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && pnpm run build:surge",
    "build-storybook": "storybook build",
    "deploy": "surge surge tatami-a11y-demo.surge.sh",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "doc": "pnpm run doc:api && docusaurus build",
    "doc:serve": "http-server docs/api -p 3001 -o",
    "doc:api": "typedoc --out docs/api src/index.ts --hideGenerator --disableSources --excludeExternals",
    "format": "prettier --write \"src/**/*.ts\" \"demo/**/*.html\" \"demo/**/*.css\" \"scripts/**/*.js\" \"*.md\"",
    "lint": "oxlint --fix",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "publish": "npm publish",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release": "standard-version",
    "serve": "http-server . -p 8080 -o /demo/index.html",
    "storybook": "storybook dev -p 6006",
    "test:verbose": "node scripts/test-verbose.js",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "vanilla-js",
    "headless",
    "ui-primitives",
    "focus-trap",
    "live-region",
    "focus-stack",
    "screen-reader",
    "reduced-motion"
  ],
  "license": "MIT",
  "devDependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/preset-classic": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/html": "^8.6.18",
    "@storybook/html-vite": "^8.6.18",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-prettier": "^5.5.6",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^15.0.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "storybook": "^8.6.18",
    "tsup": "^8.0.0",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^3.16.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^1.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
