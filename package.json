{
  "name": "tatami-a11y",
  "version": "1.0.2",
  "description": "Framework-agnostic, accessibility-first UI primitives for vanilla JavaScript",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "shared_a11y_primitives_problem.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chejholloway/tatami-a11y.git"
  },
  "homepage": "https://github.com/chejholloway/tatami-a11y#readme",
  "bugs": {
    "url": "https://github.com/chejholloway/tatami-a11y/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/chejholloway"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build:surge": "node scripts/build-surge.js",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && pnpm run build:surge",
    "build-storybook": "storybook build",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:storybook && pnpm run test && pnpm run build",
    "deploy": "node scripts/deploy.js",
    "deploy:storybook": "node scripts/build-surge.js storybook && node scripts/deploy.js storybook",
    "deploy:docs": "node scripts/build-surge.js docs && node scripts/deploy.js docs",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "doc": "pnpm run doc:api && docusaurus build",
    "doc:serve": "http-server docs/api -p 3001 -o",
    "doc:api": "typedoc --out docs/api src/index.ts --hideGenerator --disableSources --excludeExternals",
    "format": "prettier --write \"src/**/*.ts\" \"demo/**/*.html\" \"demo/**/*.css\" \"scripts/**/*.js\" \"*.md\"",
    "lint": "oxlint --fix",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release": "standard-version",
    "serve": "http-server . -p 8080 -o /demo/index.html",
    "storybook": "storybook dev -p 6006",
    "test:verbose": "node scripts/test-verbose.mjs",
    "test:watch": "vitest",
    "test": "vitest run --project=unit",
    "test:storybook": "node scripts/test-storybook.mjs",
    "test:storybook-verbose": "node scripts/test-storybook.mjs --verbose",
    "test-storybook:run": "vitest run --project=storybook",
    "test-storybook:run-verbose": "vitest run --project=storybook --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "vanilla-js",
    "headless",
    "ui-primitives",
    "focus-trap",
    "live-region",
    "focus-stack",
    "screen-reader",
    "reduced-motion"
  ],
  "license": "MIT",
  "devDependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/html": "^10.5.5",
    "@storybook/html-vite": "^10.5.5",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vitest/runner": "^4.1.5",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "10.5.5",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.76.0",
    "prettier": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "standard-version": "^9.5.0",
    "storybook": "^10.5.5",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.1.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
