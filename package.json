{
  "name": "tatami-a11y",
  "version": "1.1.0",
  "description": "Framework-agnostic, accessibility-first UI primitives for vanilla JavaScript",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./adapters/tatami.js": {
      "types": "./dist/adapters/tatami.d.ts",
      "import": "./dist/adapters/tatami.mjs",
      "require": "./dist/adapters/tatami.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "shared_a11y_primitives_problem.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chejholloway/tatami-a11y.git"
  },
  "homepage": "https://github.com/chejholloway/tatami-a11y#readme",
  "bugs": {
    "url": "https://github.com/chejholloway/tatami-a11y/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/chejholloway"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build-storybook": "storybook build -c .storybook",
    "build:rolldown": "rolldown -c rolldown.config.mjs",
    "build:surge": "node scripts/build-surge.mjs",
    "build": "tsup src/index.ts src/adapters/tatami.ts --format esm,cjs --dts --clean --tsconfig config/tsconfig.json && pnpm run build:surge",
    "ci": "pnpm run lint && pnpm run format && pnpm run test:storybook && pnpm run test && pnpm run build",
    "deploy:astro": "node scripts/build-surge.mjs astro && node scripts/deploy.mjs astro",
    "deploy:docs": "node scripts/build-surge.mjs docs && node scripts/deploy.mjs docs",
    "deploy:storybook": "node scripts/build-surge.mjs storybook && node scripts/deploy.mjs storybook",
    "deploy": "node scripts/deploy.mjs",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --tsconfig config/tsconfig.json",
    "doc:api": "typedoc --out docs/api src/index.ts src/adapters/tatami.ts --tsconfig config/tsconfig.json --hideGenerator --disableSources --excludeExternals",
    "doc:serve": "http-server docs/api -p 3001 -o",
    "doc": "pnpm run doc:api && docusaurus build --config config/docusaurus.config.cjs",
    "format": "oxfmt \"src/**/*.ts\" \"demo/**/*.html\" \"demo/**/*.css\" \"scripts/**/*.{js,mjs}\" \"*.md\"",
    "lint-staged": "lint-staged",
    "lint:type-aware": "oxlint --type-aware -c config/oxlintrc.json src/",
    "lint": "oxlint --fix -c config/oxlintrc.json src/",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release": "standard-version",
    "serve": "http-server . -p 8080 -o /demo/index.html",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "test-storybook:run-verbose": "vitest run --project=storybook --reporter=verbose",
    "test-storybook:run": "vitest run --project=storybook",
    "test:verbose": "node scripts/test-verbose.mjs",
    "test:watch": "vitest",
    "test": "vitest run --project=unit",
    "typecheck": "oxlint --type-aware -c config/oxlintrc.json src/ && tsc -p config/tsconfig.test.json"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "vanilla-js",
    "headless",
    "ui-primitives",
    "focus-trap",
    "live-region",
    "focus-stack",
    "screen-reader",
    "reduced-motion"
  ],
  "license": "MIT",
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance Improvements"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "refactor",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ]
  },
  "devDependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.0.0",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/html": "^10.5.5",
    "@storybook/html-vite": "^10.5.5",
    "@types/jsdom": "^21.1.7",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vitest/runner": "^4.1.5",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.4",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rolldown": "^1.2.1",
    "standard-version": "^9.5.0",
    "storybook": "^10.5.5",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wait-on": "^9.1.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --fix -c config/oxlintrc.json",
      "oxfmt"
    ],
    "*.{json,md}": [
      "oxfmt"
    ]
  }
}
